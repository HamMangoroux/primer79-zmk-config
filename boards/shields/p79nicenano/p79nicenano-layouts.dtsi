#include <dt-bindings/zmk/physical-layout.h>

/ {
    physical_layouts {
        compatible = "zmk,physical-layouts";

        default_layout: default_layout {
            compatible = "zmk,physical-layout";
            display-name = "Primer79 Standard";
            
            // This links your physical keys to your electrical matrix
            transform = <&default_transform>;
            
            // Format: width, height, x, y, rotation, rx, ry
            // 1U = 100. So a key at X=0, Y=0 is 100 100 0 0.
            // A key 1U to the right is 100 100 100 0.
            keys  = <
                &key_physical_attrs 100 100 0 0 0 0 0    // ESC
                &key_physical_attrs 100 100 100 0 0 0 0  // F1
                // ... You must map all 79 physical keys here in the 
                // exact order they appear in your transform map.
            >;
        };
    };
    
    chosen {
        zmk,physical-layout = &default_layout;
    };
};
