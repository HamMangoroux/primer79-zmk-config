#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = <&p79_physical_layout>;
    };

    p79_physical_layout: p79_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys
            = <&key_physical_attrs 0 0 0 0 0 0 0>
            /* Add one &key_physical_attrs entry for every key in your matrix */
            ;
    };
};
